APP_NAME=Textile
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.uz
APP_KEY=

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=textile
DB_USERNAME=textile
DB_PASSWORD=

FILESYSTEM_DISK=public
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Passport (php artisan passport:client --password bilan yaratiladi)
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=
PASSPORT_TOKEN_TTL_HOURS=12
PASSPORT_REFRESH_TTL_DAYS=30

# Sayt manzillari (CORS va to'lov qaytish havolalari uchun)
FRONTEND_URL=https://example.uz
ADMIN_URL=https://admin.example.uz

# To'lov tizimlari — shartnomadan keyin to'ldiriladi
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
UZUM_SERVICE_ID=
